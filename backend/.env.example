PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/mandi_assistant
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
# The app also reads ../.env.local, which is where Codex securely stored OPENAI_API_KEY.
OPENAI_MODEL=gpt-4o-mini
# Official OGD resource configuration. Obtain the current resource ID/key from data.gov.in.
OGD_API_KEY=
OGD_RESOURCE_ID=
OGD_API_BASE_URL=https://api.data.gov.in/resource
OGD_TIMEOUT_MS=10000
# Optional comma-separated origin allowlist overrides CORS_ORIGIN.
